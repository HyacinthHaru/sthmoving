.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 32rpx;
  line-height: 1.6;
  text-align: center;
}

.request-card {
  margin-bottom: 24rpx;
}

.request-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.request-name {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  word-break: break-all;
}

.request-time {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.request-role {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-soft-color, #e8eef6);
  color: var(--brand-color, #17365d);
  font-size: 22rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.actions button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 14rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.approve-button {
  background: var(--brand-color, #17365d) !important;
  color: #ffffff !important;
}

.reject-button {
  border: 1rpx solid #b91c1c;
  background: #fff7f7 !important;
  color: #b91c1c !important;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}
