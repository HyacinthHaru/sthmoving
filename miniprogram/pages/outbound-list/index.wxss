.heading {
  margin-bottom: 32rpx;
}

.title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 32rpx;
  line-height: 1.6;
  text-align: center;
}

.refreshing {
  margin: -16rpx 0 20rpx;
  font-size: 24rpx;
  text-align: right;
}

.request-card {
  margin-bottom: 24rpx;
}

.request-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.request-name {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  word-break: break-all;
}

.status {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 22rpx;
}

.meta,
.request-time {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.reason {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  line-height: 1.6;
  word-break: break-all;
}

.detail-button {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  margin: 18rpx 0 0;
  border: 1rpx solid var(--brand-color, #17365d);
  border-radius: 14rpx;
  color: var(--brand-color, #17365d);
  line-height: 72rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.actions button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 14rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.approve-button {
  background: var(--brand-color, #17365d) !important;
  color: #ffffff !important;
}

.reject-button {
  border: 1rpx solid #b91c1c;
  background: #fff7f7 !important;
  color: #b91c1c !important;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 26rpx;
}

.retry-button {
  margin-top: 20rpx;
}
