.bottom-navigation {
  display: flex;
  overflow: hidden;
  width: 272rpx;
  min-height: 64rpx;
  border: 1rpx solid #dce4ee;
  border-radius: 10rpx;
  background: #ffffff;
}

.navigation-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 600;
}

.navigation-item + .navigation-item {
  border-left: 1rpx solid #edf0f4;
}

.navigation-mark {
  position: absolute;
  top: 0;
  right: 18rpx;
  left: 18rpx;
  height: 4rpx;
  background: transparent;
}

.navigation-item-active {
  color: var(--brand-color, #17365d);
  background: var(--brand-soft-color, #e8eef6);
}

.navigation-item-active .navigation-mark {
  background: var(--brand-color, #17365d);
}

.navigation-item-pressed {
  opacity: 0.72;
}
