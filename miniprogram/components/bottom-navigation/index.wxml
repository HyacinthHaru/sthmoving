<view class="bottom-navigation">
  <view
    class="navigation-item {{active === 'home' ? 'navigation-item-active' : ''}}"
    data-target="home"
    bindtap="handleNavigate"
    hover-class="navigation-item-pressed"
  >
    <view class="navigation-mark"></view>
    <text>工作台</text>
  </view>
  <view
    class="navigation-item {{active === 'profile' ? 'navigation-item-active' : ''}}"
    data-target="profile"
    bindtap="handleNavigate"
    hover-class="navigation-item-pressed"
  >
    <view class="navigation-mark"></view>
    <text>个人资料</text>
  </view>
</view>
